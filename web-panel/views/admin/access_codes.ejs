          <label style="display:flex; align-items:center; gap:10px; font-size:13px; cursor:pointer; margin-bottom:10px;">
            <input type="checkbox" name="is_customizable" id="editIsCustomizable" value="1" />
            <span>🔑 Serveur Personnalisable (`isCustomizable: true`) — Génère des identifiants/clés uniques par client Premium</span>
          </label>
        </div>

        <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:24px;">
          <button type="button" class="btn-ghost" onclick="closeModal('modalEditTemplate')">Annuler</button>
          <button type="submit" class="btn-glow btn-glow-primary">Enregistrer les Modifications</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL 3: Admin Générer Code Premium -->
  <div id="modalCreateCode" class="modal-overlay">
    <div class="modal-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
        <h3 style="margin:0; font-size:20px; font-weight:900;">Générer une Clé d'Accès Premium</h3>
        <button onclick="closeModal('modalCreateCode')" style="background:none; border:none; color:#94A3B8; cursor:pointer; font-size:22px;">✕</button>
      </div>

      <form method="POST" action="/admin/access-codes">
        <div class="form-group">
          <label>Référence Client / N° Téléphone</label>
          <input type="text" name="clientReference" placeholder="ex: +225 07080910 ou Client VIP 1" class="form-control" />
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
          <div class="form-group">
            <label>Enveloppe Data Globale (Go)</label>
            <input type="number" step="0.5" name="maxDataGb" value="20" required class="form-control" />
          </div>

          <div class="form-group">
            <label>Durée de Validité (Jours)</label>
            <input type="number" name="expiryDays" value="30" required class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label>HWID / Empreinte Appareil Client (Facultatif)</label>
          <input type="text" name="hwid" placeholder="Ex: HWID-A1B2C3D4E5F6 (Vide = auto-liaison au 1er clic)" class="form-control" />
        </div>

        <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:28px;">
          <button type="button" class="btn-ghost" onclick="closeModal('modalCreateCode')">Annuler</button>
          <button type="submit" class="btn-glow btn-glow-success">Générer le Code</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openModal(id) {
      document.getElementById(id).style.display = 'flex';
    }

    function closeModal(id) {
      document.getElementById(id).style.display = 'none';
    }

    function copyCode(code) {
      navigator.clipboard.writeText(code);
      var toast = document.getElementById('toastMsg');
      toast.innerText = '📋 ' + code + ' copié !';
      toast.style.display = 'block';
      setTimeout(function() {
        toast.style.display = 'none';
      }, 2500);
    }

    function filterTable() {
      var input = document.getElementById('searchInput');
      var filter = input.value.toLowerCase();
      var table = document.getElementById('codesTable');
      var tr = table.getElementsByTagName('tr');

      for (var i = 1; i < tr.length; i++) {
        var text = tr[i].textContent || tr[i].innerText;
        tr[i].style.display = (text.toLowerCase().indexOf(filter) > -1) ? '' : 'none';
      }
    }

    function toggleAdvanced3xui() {
      var area = document.getElementById('adv3xuiArea');
      var icon = document.getElementById('advIcon');
      if (area.style.display === 'none') {
        area.style.display = 'block';
        icon.innerText = '▼';
      } else {
        area.style.display = 'none';
        icon.innerText = '▶';
      }
    }

    function selectMode(typeMode, defaultPort) {
      var cards = document.querySelectorAll('.mode-card');
      cards.forEach(function(c) { c.classList.remove('selected'); });

      var selectedCard = document.getElementById('mode_' + typeMode);
      if (selectedCard) selectedCard.classList.add('selected');

      document.getElementById('realProtocol').value = typeMode;
      document.getElementById('inputPort').value = defaultPort;

      var proxyGroup = document.getElementById('proxyGroup');
      var sniGroup = document.getElementById('sniGroup');
      var payloadGroup = document.getElementById('payloadGroup');
      var v2rayGroup = document.getElementById('v2rayGroup');
      var dnsGroup = document.getElementById('dnsGroup');

      // Hide all optional groups by default
      proxyGroup.style.display = 'none';
      sniGroup.style.display = 'none';
      payloadGroup.style.display = 'none';
      v2rayGroup.style.display = 'none';
      dnsGroup.style.display = 'none';

      if (typeMode === 'SSH_DIRECT') {
        // Standard
      } else if (typeMode === 'SSH_PROXY') {
        proxyGroup.style.display = 'grid';
        payloadGroup.style.display = 'block';
      } else if (typeMode === 'SSH_SSL') {
        sniGroup.style.display = 'block';
      } else if (typeMode === 'PAY_SSL') {
        sniGroup.style.display = 'block';
        proxyGroup.style.display = 'grid';
        payloadGroup.style.display = 'block';
      } else if (typeMode === 'SLOWDNS') {
        dnsGroup.style.display = 'grid';
      } else if (typeMode === 'XRAY_DIRECT') {
        v2rayGroup.style.display = 'block';
      } else if (typeMode === 'XRAY_PROXY') {
        v2rayGroup.style.display = 'block';
        proxyGroup.style.display = 'grid';
        payloadGroup.style.display = 'block';
      } else if (typeMode === 'XRAY_SLOWDNS') {
        v2rayGroup.style.display = 'block';
        dnsGroup.style.display = 'grid';
      } else if (typeMode === 'XTUNNEL' || typeMode === 'UDP') {
        // Standard
      }
    }

    function toggleDefaultCreds() {
      var radios = document.getElementsByName('access_type');
      var group = document.getElementById('defaultCredsGroup');
      var selected = 'base';
      for (var i = 0; i < radios.length; i++) {
        if (radios[i].checked) selected = radios[i].value;
      }
      group.style.display = (selected === 'base') ? 'block' : 'none';
    }

    function openEditTemplateModal(t) {
      document.getElementById('formEditTemplate').action = '/admin/config-templates/' + t.id + '/edit';
      document.getElementById('editName').value = t.name || '';
      document.getElementById('editInfo').value = t.info || '';
      document.getElementById('editFlag').value = t.flag || 'fr';
      document.getElementById('editProtocol').value = t.protocol || 'SSH_DIRECT';
      document.getElementById('editServerIp').value = t.server_ip || '';
      document.getElementById('editServerPort').value = t.server_port || 22;
      document.getElementById('editProxyIp').value = t.proxy_ip || '';
      document.getElementById('editProxyPort').value = t.proxy_port || 8080;
      document.getElementById('editSni').value = t.sni || '';
      document.getElementById('editPayload').value = t.payload || '';
      document.getElementById('editV2rayLink').value = t.v2ray_link || '';
      document.getElementById('editPublicKey').value = t.public_key || '';
      document.getElementById('editNameserver').value = t.nameserver || '';
      document.getElementById('editDnsServer').value = t.dns_server || '8.8.8.8';
      document.getElementById('editMaxDataGb').value = t.max_data_gb || 0;
      document.getElementById('editIsCustomizable').checked = (t.is_customizable === 1);

      openModal('modalEditTemplate');
    }

    document.addEventListener('DOMContentLoaded', function() {
      selectMode('SSH_DIRECT', '22');
    });
  </script>
</body>
</html>
