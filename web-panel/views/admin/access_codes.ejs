<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head', { title: 'Serveurs, Modes & Clés - NovaXTunnel Admin' }) %>
  <style>
    :root {
      --primary-gradient: linear-gradient(135deg, #7C5CFF 0%, #3B82F6 100%);
      --success-gradient: linear-gradient(135deg, #22C55E 0%, #10B981 100%);
      --warning-gradient: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
      --danger-gradient: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
    }

    .stat-card {
      background: rgba(30, 30, 46, 0.85);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .stat-card:hover {
      border-color: rgba(124, 92, 255, 0.4);
      box-shadow: 0 15px 40px rgba(124, 92, 255, 0.15);
    }

    /* Vibrant 3D Glowing Buttons */
    .btn-glow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 20px;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 700;
      color: #FFFFFF !important;
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      letter-spacing: 0.3px;
    }
    .btn-glow-primary {
      background: var(--primary-gradient);
      box-shadow: 0 4px 20px rgba(124, 92, 255, 0.4);
    }
    .btn-glow-primary:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 8px 28px rgba(124, 92, 255, 0.6);
    }
    .btn-glow-success {
      background: var(--success-gradient);
      box-shadow: 0 4px 20px rgba(34, 197, 94, 0.4);
    }
    .btn-glow-success:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 8px 28px rgba(34, 197, 94, 0.6);
    }
    .btn-glow-warning {
      background: var(--warning-gradient);
      box-shadow: 0 4px 20px rgba(245, 158, 11, 0.4);
    }
    .btn-glow-warning:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 8px 28px rgba(245, 158, 11, 0.6);
    }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 12px;
      border-radius: 10px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge-success { background: rgba(34, 197, 94, 0.15); color: #4ADE80; border: 1px solid rgba(34, 197, 94, 0.3); }
    .badge-danger { background: rgba(239, 68, 68, 0.15); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.3); }
    .badge-purple { background: rgba(124, 92, 255, 0.15); color: #C4B5FD; border: 1px solid rgba(124, 92, 255, 0.3); }
    .badge-blue { background: rgba(34, 211, 238, 0.15); color: #38BDF8; border: 1px solid rgba(34, 211, 238, 0.3); }
    .badge-orange { background: rgba(245, 158, 11, 0.15); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.3); }

    .code-box {
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      font-size: 14px;
      font-weight: 800;
      background: rgba(124, 92, 255, 0.15);
      color: #A78BFA;
      padding: 6px 12px;
      border-radius: 10px;
      border: 1px dashed rgba(124, 92, 255, 0.4);
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    /* App Mode Selector Cards */
    .mode-card-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 12px;
      margin-bottom: 20px;
    }
    .mode-card {
      background: rgba(255, 255, 255, 0.03);
      border: 2px solid var(--border, #2A2A3C);
      border-radius: 14px;
      padding: 12px;
      cursor: pointer;
      text-align: center;
      transition: all 0.2s ease;
    }
    .mode-card:hover {
      border-color: #7C5CFF;
      background: rgba(124, 92, 255, 0.08);
      transform: translateY(-2px);
    }
    .mode-card.selected {
      border-color: #7C5CFF;
      background: rgba(124, 92, 255, 0.18);
      box-shadow: 0 0 15px rgba(124, 92, 255, 0.3);
    }
    .mode-icon { font-size: 22px; margin-bottom: 4px; }
    .mode-title { font-size: 12px; font-weight: 800; color: #F8FAFC; }
    .mode-sub { font-size: 10px; color: var(--text-muted); margin-top: 2px; }

    .form-group { margin-bottom: 18px; }
    .form-group label { display: block; font-size: 12px; font-weight: 700; color: #94A3B8; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
    .form-control { width: 100%; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); background: #12121A; color: #F8FAFC; font-size: 13px; outline: none; transition: all 0.2s ease; }
    .form-control:focus { border-color: #7C5CFF; box-shadow: 0 0 0 4px rgba(124, 92, 255, 0.15); }

    .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); backdrop-filter: blur(8px); justify-content: center; align-items: center; z-index: 9999; padding: 16px; }
    .modal-card { background: #181825; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 24px; width: 100%; max-width: 680px; max-height: 90vh; overflow-y: auto; padding: 30px; box-shadow: 0 25px 60px rgba(0,0,0,0.7); animation: modalFade 0.25s ease; }
    @keyframes modalFade { from { opacity: 0; transform: scale(0.94); } to { opacity: 1; transform: scale(1); } }

    .toast-msg { position: fixed; bottom: 24px; right: 24px; background: var(--success-gradient); color: #fff; padding: 14px 24px; border-radius: 12px; font-weight: 800; font-size: 14px; box-shadow: 0 10px 30px rgba(34, 197, 94, 0.4); display: none; z-index: 10000; animation: toastIn 0.3s ease; }
    @keyframes toastIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
<body>
  <%
    // Helper function to render ISO country code as Unicode Flag Emoji
    function getFlagEmoji(countryCode) {
      if (!countryCode || countryCode.toLowerCase() === 'global') return '🌐';
      const code = countryCode.toLowerCase().trim();
      if (code === 'uk') return '🇬🇧';
      if (code.length !== 2) return '🌐';
      const codePoints = code
        .toUpperCase()
        .split('')
        .map(char => 127397 + char.charCodeAt(0));
      return String.fromCodePoint(...codePoints);
    }
  %>

  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <!-- TOP HEADER -->
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px; margin-bottom:28px;">
      <div>
        <h1 style="font-size:28px; font-weight:900; margin:0; letter-spacing:-0.5px; background: linear-gradient(135deg, #FFF, #94A3B8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Serveurs, Modes App & Clés Premium</h1>
        <p style="color:#94A3B8; margin:6px 0 0 0; font-size:14px;">Configurez les modes de connexion transmis à l'application Android NovaXTunnel et gérez vos clés d'accès.</p>
      </div>
      <div style="display:flex; gap:12px; flex-wrap:wrap;">
        <button class="btn-glow btn-glow-warning" onclick="openModal('modalSendNotif')">
          🔔 Diffuser Notification
        </button>
        <button class="btn-glow btn-glow-primary" onclick="openModal('modalAddTemplate')">
          ⚡ Ajouter un Serveur / Mode
        </button>
        <button class="btn-glow btn-glow-success" onclick="openModal('modalCreateCode')">
          🔑 Générer Code Premium
        </button>
      </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background:rgba(239,68,68,0.15); border:1px solid #EF4444; color:#F87171; padding:16px 20px; border-radius:14px; margin-bottom:24px; font-weight:700; font-size:14px;">
        ⚠️ <%= error %>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div style="background:rgba(34,197,94,0.15); border:1px solid #22C55E; color:#4ADE80; padding:16px 20px; border-radius:14px; margin-bottom:24px; font-weight:700; font-size:14px;">
        ✅ <%= success %>
      </div>
    <% } %>

    <!-- CARDS PARAMÈTRES API APP & UPDATE MESSAGE -->
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:20px; margin-bottom:28px;">
      <!-- CARD 1: URL API Android -->
      <div class="stat-card" style="border-color:rgba(56, 189, 248, 0.3);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
          <h3 style="margin:0; font-size:15px; color:#38BDF8; font-weight:800;">🌐 Endpoint API Android NovaXTunnel</h3>
          <span class="badge badge-blue">API v1</span>
        </div>
        <p style="font-size:12px; color:#94A3B8; margin:0 0 10px 0;">URL configurée dans votre application Android pour télécharger les serveurs et valider les clés :</p>

        <div style="margin-bottom:10px;">
          <label style="font-size:11px; color:#38BDF8; font-weight:700; margin-bottom:4px; display:block;">1. URL HTTPS (SSL Let's Encrypt Officiel) :</label>
          <div style="display:flex; gap:8px; align-items:center;">
            <input type="text" readonly value="https://<%= domain %>/api/v1/download-config" class="form-control" style="font-family:monospace; color:#38BDF8; background:rgba(0,0,0,0.4);" id="apiEndpointInput" />
            <button class="btn-ghost small" onclick="navigator.clipboard.writeText(document.getElementById('apiEndpointInput').value); copyCode('URL HTTPS');" style="padding:10px 14px; white-space:nowrap;">📋 Copier</button>
          </div>
        </div>

        <div>
          <label style="font-size:11px; color:#FBBF24; font-weight:700; margin-bottom:4px; display:block;">2. URL HTTP Direct (Secours sans SSL) :</label>
          <div style="display:flex; gap:8px; align-items:center;">
            <input type="text" readonly value="http://<%= domain %>:3000/api/v1/download-config" class="form-control" style="font-family:monospace; color:#FBBF24; background:rgba(0,0,0,0.4);" id="apiEndpointInputHttp" />
            <button class="btn-ghost small" onclick="navigator.clipboard.writeText(document.getElementById('apiEndpointInputHttp').value); copyCode('URL HTTP');" style="padding:10px 14px; white-space:nowrap;">📋 Copier</button>
          </div>
        </div>
      </div>

      <!-- CARD 2: Message de Mise à Jour App (UpdateMessage) -->
      <div class="stat-card" style="border-color:rgba(124, 92, 255, 0.3);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px;">
          <h3 style="margin:0; font-size:15px; color:#C4B5FD; font-weight:800;">💬 Message de Mise à Jour (`UpdateMessage`)</h3>
          <span class="badge badge-purple">Version App: <%= (typeof appSettings !== 'undefined' && appSettings.app_version) ? appSettings.app_version : '1.0.5' %></span>
        </div>
        <form method="POST" action="/admin/app-settings">
          <div style="display:grid; grid-template-columns:1fr 3fr; gap:10px; margin-bottom:10px;">
            <input type="text" name="app_version" value="<%= (typeof appSettings !== 'undefined' && appSettings.app_version) ? appSettings.app_version : '1.0.5' %>" placeholder="Version (ex: 1.0.5)" class="form-control" style="font-size:12px;" />
            <textarea name="update_message" rows="2" placeholder="Message HTML affiché dans l'App (ex: <b>Mise à jour réussie !</b><br/>...)" class="form-control" style="font-size:12px; resize:vertical;"><%= (typeof appSettings !== 'undefined' && appSettings.update_message) ? appSettings.update_message : '<b>★ Application NovaXTunnel à jour</b><br/>Serveurs chargés avec succès.' %></textarea>
          </div>
          <div style="text-align:right;">
            <button type="submit" class="btn-glow btn-glow-primary" style="padding:6px 14px; font-size:12px;">Enregistrer Message App</button>
          </div>
        </form>
      </div>
    </div>

    <!-- SECTION 1: NOTIFICATIONS BROADCAST ADMIN -->
    <% if (typeof notifications !== 'undefined' && notifications.length > 0) { %>
      <div class="stat-card" style="margin-bottom:30px; border-color:rgba(245, 158, 11, 0.4);">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
          <h3 style="margin:0; font-size:17px; color:#F59E0B; font-weight:800;">🔔 Notifications App Diffusées</h3>
        </div>
        <div style="overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; text-align:left; font-size:13px;">
            <thead>
              <tr style="border-bottom:1px solid var(--border); color:#94A3B8;">
                <th style="padding:10px;">Titre</th>
                <th style="padding:10px;">Message</th>
                <th style="padding:10px;">Lien Redirection</th>
                <th style="padding:10px;">Statut</th>
                <th style="padding:10px; text-align:right;">Action</th>
              </tr>
            </thead>
            <tbody>
              <% notifications.forEach(n => { %>
                <tr style="border-bottom:1px solid var(--border);">
                  <td style="padding:12px 10px; font-weight:700; color:#FBBF24;"><%= n.title %></td>
                  <td style="padding:12px 10px;"><%= n.message %></td>
                  <td style="padding:12px 10px; color:#94A3B8; font-family:monospace;"><%= n.url ? n.url : '-' %></td>
                  <td style="padding:12px 10px;">
                    <span class="badge badge-<%= n.is_active ? 'success' : 'danger' %>"><%= n.is_active ? 'Active' : 'Inactive' %></span>
                  </td>
                  <td style="padding:12px 10px; text-align:right;">
                    <form method="POST" action="/admin/broadcast-notifications/<%= n.id %>/delete" style="display:inline;" onsubmit="return confirm('Supprimer cette notification ?');">
                      <button class="btn-ghost small" style="color:#EF4444;" type="submit">Supprimer</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <!-- SECTION 2: TEMPLATES & MODES DE CONNEXION -->
    <div class="stat-card" style="margin-bottom:32px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:14px;">
        <div>
          <h3 style="margin:0; font-size:18px; font-weight:900;">1. Catalogue des Serveurs & Modes Transmis à l'App</h3>
          <p style="margin:4px 0 0 0; font-size:13px; color:#94A3B8;">Ces configurations sont directement chiffrées et envoyées à l'application Android NovaXTunnel.</p>
        </div>
        <button class="btn-glow btn-glow-primary" style="padding:9px 16px; font-size:12px;" onclick="openModal('modalAddTemplate')">
          + Ajouter un Serveur
        </button>
      </div>

      <% if (templates.length === 0) { %>
        <div style="text-align:center; padding:40px; background:rgba(255,255,255,0.01); border-radius:16px; border:1px dashed var(--border);">
          <p style="color:#94A3B8; font-size:14px; margin:0 0 16px 0;">Aucune configuration serveur n'a été ajoutée pour le moment.</p>
          <button class="btn-glow btn-glow-primary" onclick="openModal('modalAddTemplate')">+ Configurer le premier serveur</button>
        </div>
      <% } else { %>
        <div style="overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; text-align:left; font-size:13px;">
            <thead>
              <tr style="border-bottom:1px solid var(--border); color:#94A3B8; text-transform:uppercase; font-size:11px; letter-spacing:0.5px;">
                <th style="padding:14px 10px;">Drapeau & Nom</th>
                <th style="padding:14px 10px;">Type / Mode App</th>
                <th style="padding:14px 10px;">Adresse IP / Port</th>
                <th style="padding:14px 10px;">SNI / BugHost</th>
                <th style="padding:14px 10px;">Payload / Link</th>
                <th style="padding:14px 10px;">Type d'Accès</th>
                <th style="padding:14px 10px; text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% templates.forEach(t => { %>
                <tr style="border-bottom:1px solid var(--border);">
                  <td style="padding:16px 10px; font-weight:800; color:#F8FAFC;">
                    <span style="font-size:18px; margin-right:8px;"><%= getFlagEmoji(t.flag) %></span>
                    <%= t.name %>
                    <% if (t.info) { %><div style="font-size:11px; color:#94A3B8; font-weight:normal;"><%= t.info %></div><% } %>
                  </td>
                  <td style="padding:16px 10px;">
                    <span class="badge badge-<%= t.protocol.startsWith('XRAY') ? 'purple' : (t.protocol === 'SLOWDNS' ? 'orange' : 'blue') %>">
                      <%= t.protocol %>
                    </span>
                  </td>
                  <td style="padding:16px 10px; font-family:monospace; color:#38BDF8;">
                    <%= t.server_ip %>:<%= t.server_port %>
                  </td>
                  <td style="padding:16px 10px; font-family:monospace; color:#94A3B8;">
                    <%= t.sni ? t.sni : '-' %>
                  </td>
                  <td style="padding:16px 10px; font-family:monospace; color:#94A3B8; max-width:180px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                    <%= t.v2ray_link ? t.v2ray_link : (t.payload ? t.payload : '-') %>
                  </td>
                  <td style="padding:16px 10px;">
                    <% if (t.is_global_premium) { %>
                      <span class="badge badge-blue">👑 Global Premium Admin</span>
                    <% } else if (t.is_base_config) { %>
                      <span class="badge badge-purple">⭐ Gratuit Base</span>
                    <% } else { %>
                      <span class="badge">📦 Optionnel Revendeur</span>
                    <% } %>
                  </td>
                  <td style="padding:16px 10px; text-align:right;">
                    <button class="btn-ghost small" style="color:#38BDF8; margin-right:6px;" onclick='openEditTemplateModal(<%- JSON.stringify(t) %>)'>✏️ Éditer</button>
                    <form method="POST" action="/admin/config-templates/<%= t.id %>/delete" style="display:inline;" onsubmit="return confirm('Supprimer ce mode de configuration ?');">
                      <button class="btn-ghost small" style="color:#EF4444;" type="submit">Supprimer</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>

    <!-- SECTION 3: CODES D'ACCÈS PREMIUM -->
    <div class="stat-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; flex-wrap:wrap; gap:16px;">
        <div>
          <h3 style="margin:0; font-size:18px; font-weight:900;">2. Toutes les Clés Premium Générées</h3>
          <p style="margin:4px 0 0 0; font-size:13px; color:#94A3B8;">Gestion des clés avec limite de Go, durée de validité et verrouillage HWID.</p>
        </div>
        <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
          <input type="text" id="searchInput" onkeyup="filterTable()" placeholder="🔍 Rechercher par code, client ou téléphone..." style="padding:10px 16px; border-radius:12px; border:1px solid rgba(255,255,255,0.1); background:#12121A; color:#F8FAFC; width:280px; font-size:13px; outline:none;" />
          <button class="btn-glow btn-glow-success" style="padding:10px 18px; font-size:13px;" onclick="openModal('modalCreateCode')">
            + Générer un Code
          </button>
        </div>
      </div>

      <% if (accessCodes.length === 0) { %>
        <div style="text-align:center; padding:40px; background:rgba(255,255,255,0.01); border-radius:16px; border:1px dashed var(--border);">
          <p style="color:#94A3B8; font-size:14px; margin:0 0 16px 0;">Aucune clé d'accès générée pour le moment.</p>
          <button class="btn-glow btn-glow-success" onclick="openModal('modalCreateCode')">+ Générer votre première clé</button>
        </div>
      <% } else { %>
        <div style="overflow-x:auto;">
          <table id="codesTable" style="width:100%; border-collapse:collapse; text-align:left; font-size:13px;">
            <thead>
              <tr style="border-bottom:1px solid var(--border); color:#94A3B8; text-transform:uppercase; font-size:11px; letter-spacing:0.5px;">
                <th style="padding:12px 10px;">Référence Client</th>
                <th style="padding:12px 10px;">Clé / Code Premium</th>
                <th style="padding:12px 10px;">Créateur</th>
                <th style="padding:12px 10px;">Consommation Data</th>
                <th style="padding:12px 10px;">Empreinte HWID</th>
                <th style="padding:12px 10px;">Expiration</th>
                <th style="padding:12px 10px;">Statut</th>
                <th style="padding:12px 10px; text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% accessCodes.forEach(c => { %>
                <tr style="border-bottom:1px solid var(--border);">
                  <td style="padding:16px 10px; font-weight:800; color:#F8FAFC;">
                    <%= c.client_reference ? c.client_reference : 'Client Général' %>
                  </td>
                  <td style="padding:16px 10px;">
                    <div style="display:inline-flex; align-items:center; gap:8px;">
                      <span class="code-box"><%= c.code %></span>
                      <button class="btn-ghost small" onclick="copyCode('<%= c.code %>')" title="Copier le code" style="padding:6px 10px; border-radius:8px; cursor:pointer;">📋 Copier</button>
                    </div>
                  </td>
                  <td style="padding:16px 10px;"><%= c.reseller_username ? c.reseller_username : 'Administrateur' %></td>
                  <td style="padding:16px 10px;">
                    <span style="font-weight:800; color:#F8FAFC;"><%= c.consumed_data_gb.toFixed(2) %> Go</span>
                    <span style="color:#94A3B8; font-size:11px;">/ <%= c.max_data_gb > 0 ? c.max_data_gb + ' Go' : 'Illimité' %></span>
                  </td>
                  <td style="padding:16px 10px; font-family:monospace; color:#94A3B8; font-size:12px;">
                    <%= c.allowed_hwids ? c.allowed_hwids : '🟢 Non verrouillé (1er clic)' %>
                  </td>
                  <td style="padding:16px 10px;"><%= c.expiry_date ? c.expiry_date : 'Jamais' %></td>
                  <td style="padding:16px 10px;">
                    <span class="badge badge-<%= c.status === 'active' ? 'success' : 'danger' %>"><%= c.status %></span>
                  </td>
                  <td style="padding:16px 10px; text-align:right;">
                    <form method="POST" action="/admin/access-codes/<%= c.id %>/delete" style="display:inline;" onsubmit="return confirm('Supprimer ce code d\'accès ?');">
                      <button class="btn-ghost small" style="color:#EF4444;" type="submit">Supprimer</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Toast Notification -->
