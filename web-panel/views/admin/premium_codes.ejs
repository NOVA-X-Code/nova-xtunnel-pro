<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head', { title: 'Gestion des Codes Premium - NovaXTunnel Admin' }) %>
  <style>
    :root {
      --primary-gradient: linear-gradient(135deg, #7C5CFF 0%, #3B82F6 100%);
      --success-gradient: linear-gradient(135deg, #22C55E 0%, #10B981 100%);
      --warning-gradient: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
      --danger-gradient: linear-gradient(135deg, #EF4444 0%, #DC2626 100%);
    }

    .stat-card {
      background: rgba(30, 30, 46, 0.85);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .stat-card:hover {
      border-color: rgba(124, 92, 255, 0.4);
      box-shadow: 0 15px 40px rgba(124, 92, 255, 0.15);
    }

    /* Vibrant 3D Glowing Buttons */
    .btn-glow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 11px 20px;
      border-radius: 12px;
      font-size: 13px;
      font-weight: 700;
      color: #FFFFFF !important;
      border: none;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      letter-spacing: 0.3px;
    }
    .btn-glow-primary {
      background: var(--primary-gradient);
      box-shadow: 0 4px 20px rgba(124, 92, 255, 0.4);
    }
    .btn-glow-primary:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 8px 28px rgba(124, 92, 255, 0.6);
    }
    .btn-glow-success {
      background: var(--success-gradient);
      box-shadow: 0 4px 20px rgba(34, 197, 94, 0.4);
    }
    .btn-glow-success:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 8px 28px rgba(34, 197, 94, 0.6);
    }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 12px;
      border-radius: 10px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .badge-success { background: rgba(34, 197, 94, 0.15); color: #4ADE80; border: 1px solid rgba(34, 197, 94, 0.3); }
    .badge-danger { background: rgba(239, 68, 68, 0.15); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.3); }
    .badge-purple { background: rgba(124, 92, 255, 0.15); color: #C4B5FD; border: 1px solid rgba(124, 92, 255, 0.3); }
    .badge-blue { background: rgba(34, 211, 238, 0.15); color: #38BDF8; border: 1px solid rgba(34, 211, 238, 0.3); }
    .badge-orange { background: rgba(245, 158, 11, 0.15); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.3); }

    .code-box {
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      font-size: 14px;
      font-weight: 800;
      background: rgba(124, 92, 255, 0.15);
      color: #A78BFA;
      padding: 6px 12px;
      border-radius: 10px;
      border: 1px dashed rgba(124, 92, 255, 0.4);
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .form-group { margin-bottom: 18px; }
    .form-group label { display: block; font-size: 12px; font-weight: 700; color: #94A3B8; margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
    .form-control { width: 100%; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); background: #12121A; color: #F8FAFC; font-size: 13px; outline: none; transition: all 0.2s ease; }
    .form-control:focus { border-color: #7C5CFF; box-shadow: 0 0 0 4px rgba(124, 92, 255, 0.15); }

    .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); backdrop-filter: blur(8px); justify-content: center; align-items: center; z-index: 9999; padding: 16px; }
    .modal-card { background: #181825; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 24px; width: 100%; max-width: 680px; max-height: 90vh; overflow-y: auto; padding: 30px; box-shadow: 0 25px 60px rgba(0,0,0,0.7); animation: modalFade 0.25s ease; }
    @keyframes modalFade { from { opacity: 0; transform: scale(0.94); } to { opacity: 1; transform: scale(1); } }

    .toast-msg { position: fixed; bottom: 24px; right: 24px; background: var(--success-gradient); color: #fff; padding: 14px 24px; border-radius: 12px; font-weight: 800; font-size: 14px; box-shadow: 0 10px 30px rgba(34, 197, 94, 0.4); display: none; z-index: 10000; animation: toastIn 0.3s ease; }
    @keyframes toastIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
<body>

  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <!-- TOP HEADER -->
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:20px; margin-bottom:28px;">
      <div>
        <h1 style="font-size:28px; font-weight:900; margin:0; letter-spacing:-0.5px; background: linear-gradient(135deg, #FFF, #94A3B8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Gestion des Codes Premium</h1>
        <p style="color:#94A3B8; margin:6px 0 0 0; font-size:14px;">Générez et gérez les clés d'accès Premium avec suivi de la consommation en temps réel et verrouillage HWID.</p>
      </div>
      <div style="display:flex; gap:12px; flex-wrap:wrap;">
        <button class="btn-glow btn-glow-success" onclick="openModal('modalCreateCode')">
          🔑 Générer Code Premium
        </button>
      </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background:rgba(239,68,68,0.15); border:1px solid #EF4444; color:#F87171; padding:16px 20px; border-radius:14px; margin-bottom:24px; font-weight:700; font-size:14px;">
        ⚠️ <%= error %>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div style="background:rgba(34,197,94,0.15); border:1px solid #22C55E; color:#4ADE80; padding:16px 20px; border-radius:14px; margin-bottom:24px; font-weight:700; font-size:14px;">
        ✅ <%= success %>
      </div>
    <% } %>

    <!-- SUMMARY METRICS CARDS -->
    <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap:16px; margin-bottom:28px;">
      <!-- CARD 1: Online / Total -->
      <div class="stat-card" style="border-color:rgba(34, 197, 94, 0.4);">
        <div style="font-size:11px; font-weight:700; color:#4ADE80; text-transform:uppercase; margin-bottom:6px;">🟢 Clients En Ligne</div>
        <div style="font-size:24px; font-weight:900; color:#F8FAFC;">
          <%= onlineCount %> <span style="font-size:14px; color:#94A3B8; font-weight:500;">/ <%= totalCodesCount %></span>
        </div>
      </div>

      <!-- CARD 2: Total Data Consumed -->
      <div class="stat-card" style="border-color:rgba(56, 189, 248, 0.4);">
        <div style="font-size:11px; font-weight:700; color:#38BDF8; text-transform:uppercase; margin-bottom:6px;">📊 Data Totale Consommée</div>
        <div style="font-size:24px; font-weight:900; color:#38BDF8;">
          <%= totalConsumedGb.toFixed(2) %> <span style="font-size:14px; color:#94A3B8; font-weight:500;">Go</span>
        </div>
      </div>

      <!-- CARD 3: Locked -->
      <div class="stat-card" style="border-color:rgba(124, 92, 255, 0.4);">
        <div style="font-size:11px; font-weight:700; color:#C4B5FD; text-transform:uppercase; margin-bottom:6px;">🔒 Codes Verrouillés</div>
        <div style="font-size:24px; font-weight:900; color:#C4B5FD;">
          <%= lockedCount %>
        </div>
      </div>

      <!-- CARD 4: Expired -->
      <div class="stat-card" style="border-color:rgba(245, 158, 11, 0.4);">
        <div style="font-size:11px; font-weight:700; color:#FBBF24; text-transform:uppercase; margin-bottom:6px;">⌛ Codes Expirés</div>
        <div style="font-size:24px; font-weight:900; color:#FBBF24;">
          <%= expiredCount %>
        </div>
      </div>

      <!-- CARD 5: Depleted -->
      <div class="stat-card" style="border-color:rgba(239, 68, 68, 0.4);">
        <div style="font-size:11px; font-weight:700; color:#F87171; text-transform:uppercase; margin-bottom:6px;">🪫 Quota Épuisé</div>
        <div style="font-size:24px; font-weight:900; color:#F87171;">
          <%= depletedCount %>
        </div>
      </div>
    </div>

    <!-- TABLEAU DES CODES PREMIUM -->
    <div class="stat-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px; flex-wrap:wrap; gap:16px;">
        <h3 style="margin:0; font-size:18px; font-weight:900;">Toutes les Clés Premium</h3>
        <div style="display:flex; gap:12px; align-items:center; flex-wrap:wrap;">
          <input type="text" id="searchInput" onkeyup="filterTable()" placeholder="🔍 Rechercher par code, client ou téléphone..." style="padding:10px 16px; border-radius:12px; border:1px solid rgba(255,255,255,0.1); background:#12121A; color:#F8FAFC; width:280px; font-size:13px; outline:none;" />
          <button class="btn-glow btn-glow-success" style="padding:10px 18px; font-size:13px;" onclick="openModal('modalCreateCode')">
            + Générer un Code
          </button>
        </div>
      </div>

      <% if (accessCodes.length === 0) { %>
        <div style="text-align:center; padding:40px; background:rgba(255,255,255,0.01); border-radius:16px; border:1px dashed var(--border);">
          <p style="color:#94A3B8; font-size:14px; margin:0 0 16px 0;">Aucune clé d'accès générée pour le moment.</p>
          <button class="btn-glow btn-glow-success" onclick="openModal('modalCreateCode')">+ Générer votre première clé</button>
        </div>
      <% } else { %>
        <div style="overflow-x:auto;">
          <table id="codesTable" style="width:100%; border-collapse:collapse; text-align:left; font-size:13px;">
            <thead>
              <tr style="border-bottom:1px solid var(--border); color:#94A3B8; text-transform:uppercase; font-size:11px; letter-spacing:0.5px;">
                <th style="padding:12px 10px;">Référence Client</th>
                <th style="padding:12px 10px;">Clé / Code Premium</th>
                <th style="padding:12px 10px;">Créateur</th>
                <th style="padding:12px 10px;">Activité</th>
                <th style="padding:12px 10px;">Consommation Data</th>
                <th style="padding:12px 10px;">Empreinte HWID</th>
                <th style="padding:12px 10px;">Expiration</th>
                <th style="padding:12px 10px;">Statut</th>
                <th style="padding:12px 10px; text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% accessCodes.forEach(c => { %>
                <tr style="border-bottom:1px solid var(--border);">
                  <td style="padding:16px 10px; font-weight:800; color:#F8FAFC;">
                    <%= c.client_reference ? c.client_reference : 'Client Général' %>
                  </td>
                  <td style="padding:16px 10px;">
                    <div style="display:inline-flex; align-items:center; gap:8px;">
                      <span class="code-box"><%= c.code %></span>
                      <button class="btn-ghost small" onclick="copyCode('<%= c.code %>')" title="Copier le code" style="padding:6px 10px; border-radius:8px; cursor:pointer;">📋 Copier</button>
                    </div>
                  </td>
                  <td style="padding:16px 10px;"><%= c.reseller_username ? c.reseller_username : 'Administrateur' %></td>
                  <td style="padding:16px 10px;">
                    <% if (c.last_seen_at && (Date.now() - c.last_seen_at) < 35000) { %>
                      <span class="badge badge-success" style="box-shadow: 0 0 10px rgba(34, 197, 94, 0.4);">🟢 En Ligne</span>
                    <% } else { %>
                      <span class="badge" style="background:rgba(255,255,255,0.05); color:#94A3B8;">🔴 Hors Ligne</span>
                    <% } %>
                  </td>
                  <td style="padding:16px 10px;">
                    <span style="font-weight:800; color:#F8FAFC;"><%= c.consumed_data_gb.toFixed(2) %> Go</span>
                    <span style="color:#94A3B8; font-size:11px;">/ <%= c.max_data_gb > 0 ? c.max_data_gb + ' Go' : 'Illimité' %></span>
                  </td>
                  <td style="padding:16px 10px; font-family:monospace; color:#94A3B8; font-size:12px;">
                    <%= c.allowed_hwids ? c.allowed_hwids : '🟢 Non verrouillé (1er clic)' %>
                  </td>
                  <td style="padding:16px 10px;"><%= c.expiry_date ? c.expiry_date : 'Jamais' %></td>
                  <td style="padding:16px 10px;">
                    <span class="badge badge-<%= c.status === 'active' ? 'success' : 'danger' %>"><%= c.status %></span>
                  </td>
                  <td style="padding:16px 10px; text-align:right;">
                    <button class="btn-ghost small" style="color:#38BDF8; margin-right:6px;" onclick='openEditCodeModal(<%- JSON.stringify(c) %>)'>✏️ Éditer</button>
                    <form method="POST" action="/admin/access-codes/<%= c.id %>/delete" style="display:inline;" onsubmit="return confirm('Supprimer ce code d\'accès ?');">
                      <button class="btn-ghost small" style="color:#EF4444;" type="submit">Supprimer</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toastMsg" class="toast-msg">📋 Code copié dans le presse-papier !</div>

  <!-- MODAL 3: Admin Générer Code Premium -->
  <div id="modalCreateCode" class="modal-overlay">
    <div class="modal-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
        <h3 style="margin:0; font-size:20px; font-weight:900;">Générer une Clé d'Accès Premium</h3>
        <button onclick="closeModal('modalCreateCode')" style="background:none; border:none; color:#94A3B8; cursor:pointer; font-size:22px;">✕</button>
      </div>

      <form method="POST" action="/admin/access-codes">
        <div class="form-group">
          <label>Référence Client / N° Téléphone</label>
          <input type="text" name="clientReference" placeholder="ex: +225 07080910 ou Client VIP 1" class="form-control" />
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
          <div class="form-group">
            <label>Enveloppe Data Globale (Go, 0 = Illimité)</label>
            <input type="number" step="0.5" name="maxDataGb" value="20" class="form-control" />
          </div>

          <div class="form-group">
            <label>Date d'Expiration Calendrier (Optionnel)</label>
            <input type="date" name="expiryDate" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label>HWID / Empreinte Appareil Client (Facultatif)</label>
          <input type="text" name="hwid" placeholder="Ex: HWID-A1B2C3D4E5F6 (Vide = auto-liaison au 1er clic)" class="form-control" />
        </div>

        <% if (typeof extraTemplates !== 'undefined' && extraTemplates.length > 0) { %>
          <div class="form-group" style="margin-top:18px; border-top:1px solid var(--border); padding-top:14px;">
            <label>Serveurs Premium Optionnels à Inclure (UUID Custom & Limite Data)</label>
            <div style="max-height:180px; overflow-y:auto; border:1px solid var(--border); border-radius:10px; padding:10px; background:rgba(0,0,0,0.3);">
              <% extraTemplates.forEach(t => { %>
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; gap:10px; flex-wrap:wrap;">
                  <label style="display:flex; align-items:center; gap:8px; font-size:13px; cursor:pointer;">
                    <input type="checkbox" name="selectedTemplateIds" value="<%= t.id %>" checked />
                    <span style="font-weight:600; color:#F8FAFC;"><%= t.name %></span>
                    <span class="badge badge-purple" style="font-size:10px; padding:2px 6px;"><%= t.protocol.toUpperCase() %></span>
                    <% if (t.is_admin_only) { %><span class="badge badge-blue" style="font-size:9px;">👑 Admin</span><% } %>
                  </label>
                  <div style="display:flex; gap:6px; align-items:center;">
                    <% if (t.protocol.toLowerCase().includes('vless') || t.protocol.toLowerCase().includes('vmess') || t.protocol.toLowerCase().includes('trojan') || t.protocol.toUpperCase().startsWith('XRAY_')) { %>
                      <input type="text" name="custom_uuid_<%= t.id %>" placeholder="UUID Custom" class="form-control" style="width:170px; padding:4px 8px; font-size:11px;" />
                    <% } %>
                    <input type="number" step="0.5" name="template_max_gb_<%= t.id %>" placeholder="Go (0=global)" class="form-control" style="width:100px; padding:4px 8px; font-size:11px;" />
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>

        <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:28px;">
          <button type="button" class="btn-ghost" onclick="closeModal('modalCreateCode')">Annuler</button>
          <button type="submit" class="btn-glow btn-glow-success">Générer le Code</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL 3.5: ÉDITER UN CODE PREMIUM -->
  <div id="modalEditCode" class="modal-overlay">
    <div class="modal-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
        <h3 style="margin:0; font-size:20px; font-weight:900;">✏️ Éditer le Code Premium</h3>
        <button onclick="closeModal('modalEditCode')" style="background:none; border:none; color:#94A3B8; cursor:pointer; font-size:22px;">✕</button>
      </div>

      <form method="POST" id="formEditCode" action="">
        <div class="form-group">
          <label>Référence Client / N° Téléphone</label>
          <input type="text" name="clientReference" id="editCodeClientRef" class="form-control" />
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
          <div class="form-group">
            <label>Plafond Data Globale (Go, 0 = Illimité)</label>
            <input type="number" step="0.5" name="maxDataGb" id="editCodeMaxDataGb" class="form-control" />
          </div>

          <div class="form-group">
            <label>Date d'Expiration Calendrier (`expiryDate`)</label>
            <input type="date" name="expiryDate" id="editCodeExpiryDate" class="form-control" />
          </div>
        </div>

        <div style="display:grid; grid-template-columns:2fr 1fr; gap:14px;">
          <div class="form-group">
            <label>HWID Appareil (Laissez vide pour Réinitialiser le Verrouillage Appareil)</label>
            <input type="text" name="hwid" id="editCodeHwid" placeholder="Ex: A1B2C3D4 (Vide = déverrouiller)" class="form-control" />
          </div>

          <div class="form-group">
            <label>Statut</label>
            <select name="status" id="editCodeStatus" class="form-control">
              <option value="active">Active</option>
              <option value="expired">Expired</option>
              <option value="depleted">Depleted</option>
              <option value="locked">Locked</option>
            </select>
          </div>
        </div>

        <% if (typeof extraTemplates !== 'undefined' && extraTemplates.length > 0) { %>
          <div class="form-group" style="margin-top:18px; border-top:1px solid var(--border); padding-top:14px;">
            <label>Gérer les Serveurs Premium Optionnels Associés (UUID Custom & Limite Data)</label>
            <div style="max-height:180px; overflow-y:auto; border:1px solid var(--border); border-radius:10px; padding:10px; background:rgba(0,0,0,0.3);">
              <% extraTemplates.forEach(t => { %>
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; gap:10px; flex-wrap:wrap;">
                  <label style="display:flex; align-items:center; gap:8px; font-size:13px; cursor:pointer;">
                    <input type="checkbox" name="selectedTemplateIds" id="edit_code_tmpl_<%= t.id %>" value="<%= t.id %>" />
                    <span style="font-weight:600; color:#F8FAFC;"><%= t.name %></span>
                    <span class="badge badge-purple" style="font-size:10px; padding:2px 6px;"><%= t.protocol.toUpperCase() %></span>
                    <% if (t.is_admin_only) { %><span class="badge badge-blue" style="font-size:9px;">👑 Admin</span><% } %>
                  </label>
                  <div style="display:flex; gap:6px; align-items:center;">
                    <% if (t.protocol.toLowerCase().includes('vless') || t.protocol.toLowerCase().includes('vmess') || t.protocol.toLowerCase().includes('trojan') || t.protocol.toUpperCase().startsWith('XRAY_')) { %>
                      <input type="text" name="custom_uuid_<%= t.id %>" id="edit_code_uuid_<%= t.id %>" placeholder="UUID Custom" class="form-control" style="width:170px; padding:4px 8px; font-size:11px;" />
                    <% } %>
                    <input type="number" step="0.5" name="template_max_gb_<%= t.id %>" id="edit_code_max_gb_<%= t.id %>" placeholder="Go (0=global)" class="form-control" style="width:100px; padding:4px 8px; font-size:11px;" />
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:28px;">
          <button type="button" class="btn-ghost small" style="color:#F59E0B;" onclick="if(confirm('Remettre la consommation globale de cette clé à 0 Go et la réactiver ?')) document.getElementById('formResetCodeUsage').submit();">🔄 Remettre Conso à 0 Go</button>
          <div style="display:flex; gap:12px;">
            <button type="button" class="btn-ghost" onclick="closeModal('modalEditCode')">Annuler</button>
            <button type="submit" class="btn-glow btn-glow-success">Enregistrer les Modifications</button>
          </div>
        </div>
      </form>
      <form method="POST" id="formResetCodeUsage" action="" style="display:none;"></form>
    </div>
  </div>

  <script>
    function openModal(id) {
      document.getElementById(id).style.display = 'flex';
    }

    function closeModal(id) {
      document.getElementById(id).style.display = 'none';
    }

    function copyCode(code) {
      navigator.clipboard.writeText(code);
      var toast = document.getElementById('toastMsg');
      toast.innerText = '📋 ' + code + ' copié !';
      toast.style.display = 'block';
      setTimeout(function() {
        toast.style.display = 'none';
      }, 2500);
    }

    function filterTable() {
      var input = document.getElementById('searchInput');
      var filter = input.value.toLowerCase();
      var table = document.getElementById('codesTable');
      var tr = table.getElementsByTagName('tr');

      for (var i = 1; i < tr.length; i++) {
        var text = tr[i].textContent || tr[i].innerText;
        tr[i].style.display = (text.toLowerCase().indexOf(filter) > -1) ? '' : 'none';
      }
    }

    function openEditCodeModal(c) {
      document.getElementById('formEditCode').action = '/admin/access-codes/' + c.id + '/edit';
      document.getElementById('formResetCodeUsage').action = '/admin/access-codes/' + c.id + '/reset-usage';
      document.getElementById('editCodeClientRef').value = c.client_reference || '';
      document.getElementById('editCodeMaxDataGb').value = c.max_data_gb || 0;
      document.getElementById('editCodeExpiryDate').value = c.expiry_date || '';
      document.getElementById('editCodeHwid').value = c.allowed_hwids || '';
      document.getElementById('editCodeStatus').value = c.status || 'active';

      <% if (typeof extraTemplates !== 'undefined' && extraTemplates.length > 0) { %>
        <% extraTemplates.forEach(t => { %>
          var chk = document.getElementById('edit_code_tmpl_' + <%= t.id %>);
          var inputGb = document.getElementById('edit_code_max_gb_' + <%= t.id %>);
          var inputUuid = document.getElementById('edit_code_uuid_' + <%= t.id %>);
          if (chk) chk.checked = false;
          if (inputGb) inputGb.value = '';
          if (inputUuid) inputUuid.value = '';
        <% }); %>
        if (c.credentials && Array.isArray(c.credentials)) {
          c.credentials.forEach(function(cr) {
            var chk = document.getElementById('edit_code_tmpl_' + cr.config_template_id);
            var inputGb = document.getElementById('edit_code_max_gb_' + cr.config_template_id);
            var inputUuid = document.getElementById('edit_code_uuid_' + cr.config_template_id);
            if (chk) chk.checked = true;
            if (inputGb && cr.template_max_data_gb) inputGb.value = cr.template_max_data_gb;
            if (inputUuid && cr.client_uuid_or_user) inputUuid.value = cr.client_uuid_or_user;
          });
        }
      <% } %>

      openModal('modalEditCode');
    }
  </script>
</body>
</html>
