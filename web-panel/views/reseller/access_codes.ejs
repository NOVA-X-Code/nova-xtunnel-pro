<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head', { title: 'Clés d\'Accès Premium - NovaXTunnel Revendeur' }) %>
  <style>
    .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin-bottom: 24px; }
    .stat-card { background: var(--bg-card, #1E1E2E); border: 1px solid var(--border, #2A2A3C); border-radius: 16px; padding: 22px; box-shadow: 0 4px 20px rgba(0,0,0,0.15); transition: all 0.2s ease; }
    .stat-card:hover { border-color: rgba(124, 92, 255, 0.4); }
    .stat-title { font-size: 12px; font-weight: 700; color: var(--text-muted, #94A3B8); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; }
    .stat-value { font-size: 24px; font-weight: 800; color: var(--text, #FFF); }

    .badge { display: inline-flex; align-items: center; gap: 4px; padding: 4px 10px; border-radius: 8px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
    .badge-success { background: rgba(34, 197, 94, 0.15); color: #22C55E; border: 1px solid rgba(34, 197, 94, 0.3); }
    .badge-danger { background: rgba(239, 68, 68, 0.15); color: #EF4444; border: 1px solid rgba(239, 68, 68, 0.3); }
    .badge-warning { background: rgba(245, 158, 11, 0.15); color: #F59E0B; border: 1px solid rgba(245, 158, 11, 0.3); }

    .code-box { font-family: 'JetBrains Mono', 'Fira Code', monospace; font-size: 14px; font-weight: 800; background: rgba(124, 92, 255, 0.12); color: #C4B5FD; padding: 6px 10px; border-radius: 8px; border: 1px dashed rgba(124, 92, 255, 0.3); display: inline-flex; align-items: center; gap: 6px; }

    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 12px; font-weight: 600; color: var(--text-muted, #94A3B8); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px; }
    .form-control { width: 100%; padding: 10px 12px; border-radius: 10px; border: 1px solid var(--border, #2A2A3C); background: var(--bg, #12121A); color: var(--text, #F8FAFC); font-size: 13px; outline: none; transition: border-color 0.2s ease; }
    .form-control:focus { border-color: #7C5CFF; box-shadow: 0 0 0 3px rgba(124, 92, 255, 0.15); }

    .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.75); backdrop-filter: blur(4px); justify-content: center; align-items: center; z-index: 9999; padding: 16px; }
    .modal-card { background: var(--bg-card, #1E1E2E); border: 1px solid var(--border, #2A2A3C); border-radius: 20px; width: 100%; max-width: 520px; max-height: 90vh; overflow-y: auto; padding: 28px; box-shadow: 0 20px 50px rgba(0,0,0,0.6); animation: modalFade 0.2s ease; }
    @keyframes modalFade { from { opacity: 0; transform: scale(0.95); } to { opacity: 1; transform: scale(1); } }

    .toast-msg { position: fixed; bottom: 20px; right: 20px; background: #22C55E; color: #fff; padding: 12px 20px; border-radius: 10px; font-weight: 700; font-size: 13px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); display: none; z-index: 10000; animation: toastIn 0.3s ease; }
    @keyframes toastIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
<body>
  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; margin-bottom:28px;">
      <div>
        <h1 style="font-size:26px; font-weight:800; margin:0; letter-spacing:-0.5px;">Génération des Clés d'Accès Premium</h1>
        <p style="color:var(--text-muted); margin:6px 0 0 0; font-size:14px;">Créez des clés d'accès chiffrées avec suivi des appareils (HWID), expiration et quota de données.</p>
      </div>
      <button class="btn-primary" style="background:#22C55E; border:none; padding:10px 18px; font-size:14px;" onclick="openModal('modalCreateCode')">
        + Générer une Clé Premium
      </button>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background:rgba(239,68,68,0.15); border:1px solid #EF4444; color:#EF4444; padding:14px 18px; border-radius:12px; margin-bottom:24px; font-weight:600; font-size:14px;">
        ⚠️ <%= error %>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div style="background:rgba(34,197,94,0.15); border:1px solid #22C55E; color:#4ADE80; padding:14px 18px; border-radius:12px; margin-bottom:24px; font-weight:600; font-size:14px;">
        ✅ <%= success %>
      </div>
    <% } %>

    <!-- TABLEAU DES CODES GENERES -->
    <div class="stat-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:12px;">
        <h3 style="margin:0; font-size:18px; font-weight:800;">Mes Clés Premium Générées</h3>
      </div>

      <% if (accessCodes.length === 0) { %>
        <div style="text-align:center; padding:32px; background:var(--bg); border-radius:12px; border:1px dashed var(--border);">
          <p style="color:var(--text-muted); font-size:14px; margin:0 0 16px 0;">Vous n'avez pas encore généré de clé d'accès Premium.</p>
          <button class="btn-primary" style="background:#22C55E; border:none;" onclick="openModal('modalCreateCode')">+ Générer votre première clé</button>
        </div>
      <% } else { %>
        <div style="overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; text-align:left; font-size:13px;">
            <thead>
              <tr style="border-bottom:1px solid var(--border); color:var(--text-muted); text-transform:uppercase; font-size:11px; letter-spacing:0.5px;">
                <th style="padding:12px 10px;">Référence Client</th>
                <th style="padding:12px 10px;">Clé Premium</th>
                <th style="padding:12px 10px;">Consommation Data</th>
                <th style="padding:12px 10px;">Empreinte Appareil (HWID)</th>
                <th style="padding:12px 10px;">Expiration</th>
                <th style="padding:12px 10px;">Statut</th>
                <th style="padding:12px 10px; text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% accessCodes.forEach(c => { %>
                <tr style="border-bottom:1px solid var(--border);">
                  <td style="padding:14px 10px; font-weight:700;">
                    <%= c.client_reference ? c.client_reference : 'Client Général' %>
                  </td>
                  <td style="padding:14px 10px;">
                    <div style="display:inline-flex; align-items:center; gap:6px;">
                      <span class="code-box"><%= c.code %></span>
                      <button class="btn-ghost small" onclick="copyCode('<%= c.code %>')" title="Copier la clé" style="padding:4px 8px; border-radius:6px; cursor:pointer;">📋</button>
                    </div>
                  </td>
                  <td style="padding:14px 10px;">
                    <span style="font-weight:700; color:#F8FAFC;"><%= c.consumed_data_gb.toFixed(2) %> Go</span>
                    <span style="color:var(--text-muted); font-size:11px;">/ <%= c.max_data_gb > 0 ? c.max_data_gb + ' Go' : 'Illimité' %></span>
                  </td>
                  <td style="padding:14px 10px; font-family:monospace; color:var(--text-muted); font-size:12px;">
                    <%= c.allowed_hwids ? c.allowed_hwids : '🟢 Non verrouillé (1er appareil)' %>
                  </td>
                  <td style="padding:14px 10px;"><%= c.expiry_date ? c.expiry_date : 'Jamais' %></td>
                  <td style="padding:14px 10px;">
                    <% if (c.status === 'active') { %>
                      <span class="badge badge-success">Actif</span>
                    <% } else if (c.status === 'expired') { %>
                      <span class="badge badge-warning">Expiré</span>
                    <% } else { %>
                      <span class="badge badge-danger"><%= c.status %></span>
                    <% } %>
                  </td>
                  <td style="padding:14px 10px; text-align:right;">
                    <button class="btn-ghost small" style="color:#38BDF8; margin-right:6px;" onclick='openEditCodeModal(<%- JSON.stringify(c) %>)'>✏️ Éditer</button>
                    <form method="POST" action="/reseller/access-codes/<%= c.id %>/delete" style="display:inline;" onsubmit="return confirm('Supprimer ce code d\'accès ?');">
                      <button class="btn-ghost small" style="color:#EF4444;" type="submit">Supprimer</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toastMsg" class="toast-msg">📋 Code copié dans le presse-papier !</div>

  <!-- MODAL 1: Création Code Premium Revendeur -->
  <div id="modalCreateCode" class="modal-overlay">
    <div class="modal-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <h3 style="margin:0; font-size:18px; font-weight:800;">Générer une Clé d'Accès Premium</h3>
        <button onclick="closeModal('modalCreateCode')" style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-size:20px;">✕</button>
      </div>

      <form method="POST" action="/reseller/access-codes">
        <div class="form-group">
          <label>Référence Client / N° Téléphone</label>
          <input type="text" name="clientReference" placeholder="ex: +225 07080910 ou Jean Dupont" class="form-control" />
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
          <div class="form-group">
            <label>Enveloppe Data Globale (Go)</label>
            <input type="number" step="0.5" name="maxDataGb" value="10" required class="form-control" />
          </div>

          <div class="form-group">
            <label>Durée de Validité (Jours)</label>
            <input type="number" name="expiryDays" value="30" required class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label>HWID / Device ID Client (Facultatif)</label>
          <input type="text" name="hwid" placeholder="Ex: HWID-A1B2C3D4E5F6 (Vide = auto-liaison au 1er clic)" class="form-control" />
        </div>

        <% if (extraTemplates && extraTemplates.length > 0) { %>
          <div class="form-group" style="margin-top:18px; border-top:1px solid var(--border); padding-top:14px;">
            <label>Serveurs Premium Optionnels à Inclure & Limites Data Spécifiques</label>
            <div style="max-height:160px; overflow-y:auto; border:1px solid var(--border); border-radius:10px; padding:10px; background:var(--bg);">
              <% extraTemplates.forEach(t => { %>
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; gap:10px;">
                  <label style="display:flex; align-items:center; gap:8px; font-size:13px; cursor:pointer;">
                    <input type="checkbox" name="selectedTemplateIds" value="<%= t.id %>" checked />
                    <span style="font-weight:600; color:#F8FAFC;"><%= t.name %></span>
                    <span class="badge badge-purple" style="font-size:10px; padding:2px 6px;"><%= t.protocol.toUpperCase() %></span>
                  </label>
                  <input type="number" step="0.5" name="template_max_gb_<%= t.id %>" placeholder="Go (0=global)" class="form-control" style="width:110px; padding:4px 8px; font-size:11px;" />
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>

        <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:24px;">
          <button type="button" class="btn-ghost" onclick="closeModal('modalCreateCode')">Annuler</button>
          <button type="submit" class="btn-primary" style="background:#22C55E; border:none;">Générer la Clé</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL 2: Éditeur Code Premium Revendeur -->
  <div id="modalEditCode" class="modal-overlay">
    <div class="modal-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <h3 style="margin:0; font-size:18px; font-weight:800;">✏️ Éditer le Code Premium</h3>
        <button onclick="closeModal('modalEditCode')" style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-size:20px;">✕</button>
      </div>

      <form method="POST" id="formEditCode" action="">
        <div class="form-group">
          <label>Référence Client / N° Téléphone</label>
          <input type="text" name="clientReference" id="editCodeClientRef" class="form-control" />
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
          <div class="form-group">
            <label>Plafond Data Globale (Go)</label>
            <input type="number" step="0.5" name="maxDataGb" id="editCodeMaxDataGb" class="form-control" />
          </div>

          <div class="form-group">
            <label>Prolonger Validité (Jours)</label>
            <input type="number" name="expiryDays" id="editCodeExpiryDays" value="30" class="form-control" />
          </div>
        </div>

        <div style="display:grid; grid-template-columns:2fr 1fr; gap:14px;">
          <div class="form-group">
            <label>HWID (Laissez vide pour Réinitialiser le Verrouillage Appareil)</label>
            <input type="text" name="hwid" id="editCodeHwid" placeholder="Ex: A1B2C3D4 (Vide = déverrouiller)" class="form-control" />
          </div>

          <div class="form-group">
            <label>Statut</label>
            <select name="status" id="editCodeStatus" class="form-control">
              <option value="active">Active</option>
              <option value="expired">Expired</option>
              <option value="depleted">Depleted</option>
              <option value="locked">Locked</option>
            </select>
          </div>
        </div>

        <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:24px;">
          <button type="button" class="btn-ghost" onclick="closeModal('modalEditCode')">Annuler</button>
          <button type="submit" class="btn-primary" style="background:#22C55E; border:none;">Enregistrer les Modifications</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openModal(id) {
      document.getElementById(id).style.display = 'flex';
    }

    function closeModal(id) {
      document.getElementById(id).style.display = 'none';
    }

    function copyCode(code) {
      navigator.clipboard.writeText(code);
      var toast = document.getElementById('toastMsg');
      toast.innerText = '📋 Clé ' + code + ' copiée !';
      toast.style.display = 'block';
      setTimeout(function() {
        toast.style.display = 'none';
      }, 2500);
    }

    function openEditCodeModal(c) {
      document.getElementById('formEditCode').action = '/reseller/access-codes/' + c.id + '/edit';
      document.getElementById('editCodeClientRef').value = c.client_reference || '';
      document.getElementById('editCodeMaxDataGb').value = c.max_data_gb || 0;
      document.getElementById('editCodeExpiryDays').value = c.expiry_days || 30;
      document.getElementById('editCodeHwid').value = c.allowed_hwids || '';
      document.getElementById('editCodeStatus').value = c.status || 'active';

      openModal('modalEditCode');
    }
  </script>
</body>
</html>
