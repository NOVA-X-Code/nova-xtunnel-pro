<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <%- include('../partials/head', { title: 'Mes Clés Premium - NovaXTunnel Revendeur' }) %>
  <style>
    .stat-card {
      background: rgba(30, 30, 46, 0.85);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px;
      padding: 24px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.3);
      margin-bottom: 24px;
    }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 5px 12px;
      border-radius: 10px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
    }
    .badge-success { background: rgba(34, 197, 94, 0.15); color: #4ADE80; border: 1px solid rgba(34, 197, 94, 0.3); }
    .badge-danger { background: rgba(239, 68, 68, 0.15); color: #F87171; border: 1px solid rgba(239, 68, 68, 0.3); }
    .badge-warning { background: rgba(245, 158, 11, 0.15); color: #FBBF24; border: 1px solid rgba(245, 158, 11, 0.3); }
    .badge-purple { background: rgba(124, 92, 255, 0.15); color: #C4B5FD; border: 1px solid rgba(124, 92, 255, 0.3); }

    .code-box {
      font-family: 'JetBrains Mono', 'Fira Code', monospace;
      font-size: 14px;
      font-weight: 800;
      background: rgba(124, 92, 255, 0.15);
      color: #A78BFA;
      padding: 6px 12px;
      border-radius: 10px;
      border: 1px dashed rgba(124, 92, 255, 0.4);
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; font-size: 12px; font-weight: 700; color: var(--text-muted); margin-bottom: 6px; text-transform: uppercase; }
    .form-control { width: 100%; padding: 10px 14px; border-radius: 10px; border: 1px solid var(--border); background: var(--bg); color: var(--text); font-size: 13px; outline: none; }

    .modal-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.75); backdrop-filter: blur(6px); justify-content: center; align-items: center; z-index: 9999; padding: 16px; }
    .modal-card { background: var(--card-bg, #181825); border: 1px solid var(--border); border-radius: 20px; width: 100%; max-width: 600px; max-height: 90vh; overflow-y: auto; padding: 24px; box-shadow: 0 20px 50px rgba(0,0,0,0.6); }

    .toast-msg { position: fixed; bottom: 24px; right: 24px; background: #22C55E; color: #fff; padding: 12px 20px; border-radius: 10px; font-weight: 700; font-size: 13px; box-shadow: 0 8px 24px rgba(34, 197, 94, 0.4); display: none; z-index: 10000; }
  </style>
</head>
<body>

  <%- include('../partials/sidebar') %>

  <div class="main-content">
    <!-- HEADER -->
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:16px; margin-bottom:24px;">
      <div>
        <h1 style="font-size:24px; font-weight:800; margin:0;">Espace Clés Premium Revendeur</h1>
        <p style="color:var(--text-muted); margin:4px 0 0 0; font-size:13px;">Générez et gérez les clés d'accès pour vos clients.</p>
      </div>
      <button class="btn-primary" style="background:#22C55E; border:none; padding:10px 18px; font-weight:700;" onclick="openModal('modalCreateCode')">
        + Générer une Clé Premium
      </button>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background:rgba(239,68,68,0.15); border:1px solid #EF4444; color:#F87171; padding:14px 18px; border-radius:12px; margin-bottom:24px; font-weight:600; font-size:14px;">
        ⚠️ <%= error %>
      </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
      <div style="background:rgba(34,197,94,0.15); border:1px solid #22C55E; color:#4ADE80; padding:14px 18px; border-radius:12px; margin-bottom:24px; font-weight:600; font-size:14px;">
        ✅ <%= success %>
      </div>
    <% } %>

    <!-- CARDE SOLDE DATA REVENDEUR -->
    <div class="stat-card" style="margin-bottom:24px; border-color:rgba(56, 189, 248, 0.3);">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <div>
          <h3 style="margin:0; font-size:16px; color:#38BDF8; font-weight:800;">📊 Solde Data Revendeur Alloué par l'Admin</h3>
          <p style="margin:4px 0 0 0; font-size:12px; color:#94A3B8;">Solde total de données utilisable pour créer des clés Premium clients.</p>
        </div>
        <div style="text-align:right;">
          <span style="font-size:22px; font-weight:900; color:#38BDF8;" id="resellerQuotaText">
            <%= reseller.data_quota_gb !== null ? reseller.data_quota_gb.toFixed(2) + ' Go' : 'Illimité' %>
          </span>
        </div>
      </div>
    </div>

    <!-- TABLEAU DES CODES GENERES -->
    <div class="stat-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:12px;">
        <% const onlineCount = accessCodes.filter(c => c.last_seen_at && (Date.now() - c.last_seen_at) < 35000).length; %>
        <div style="display:flex; align-items:center; gap:12px;">
          <h3 style="margin:0; font-size:18px; font-weight:800;">Mes Clés Premium Générées</h3>
          <span class="badge badge-success" id="resellerOnlineBadge" style="font-size:11px; padding:5px 12px; box-shadow: 0 0 12px rgba(34, 197, 94, 0.3);">🟢 <%= onlineCount %> Clients En Ligne</span>
        </div>
      </div>

      <% if (accessCodes.length === 0) { %>
        <div style="text-align:center; padding:32px; background:var(--bg); border-radius:12px; border:1px dashed var(--border);">
          <p style="color:var(--text-muted); font-size:14px; margin:0 0 16px 0;">Vous n'avez pas encore généré de clé d'accès Premium.</p>
          <button class="btn-primary" style="background:#22C55E; border:none;" onclick="openModal('modalCreateCode')">+ Générer votre première clé</button>
        </div>
      <% } else { %>
        <div style="overflow-x:auto;">
          <table style="width:100%; border-collapse:collapse; text-align:left; font-size:13px;">
            <thead>
              <tr style="border-bottom:1px solid var(--border); color:var(--text-muted); text-transform:uppercase; font-size:11px; letter-spacing:0.5px;">
                <th style="padding:12px 10px;">Référence Client</th>
                <th style="padding:12px 10px;">Clé Premium</th>
                <th style="padding:12px 10px;">Activité</th>
                <th style="padding:12px 10px;">Consommation Data</th>
                <th style="padding:12px 10px;">Empreinte Appareil (HWID)</th>
                <th style="padding:12px 10px;">Expiration</th>
                <th style="padding:12px 10px;">Statut</th>
                <th style="padding:12px 10px; text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% accessCodes.forEach(c => { %>
                <tr style="border-bottom:1px solid var(--border);">
                  <td style="padding:14px 10px; font-weight:700;">
                    <%= c.client_reference ? c.client_reference : 'Client Général' %>
                  </td>
                  <td style="padding:14px 10px;">
                    <div style="display:inline-flex; align-items:center; gap:6px;">
                      <span class="code-box"><%= c.code %></span>
                      <button class="btn-ghost small" onclick="copyCode('<%= c.code %>')" title="Copier la clé" style="padding:4px 8px; border-radius:6px; cursor:pointer;">📋</button>
                    </div>
                  </td>
                  <td style="padding:14px 10px;" id="reseller_online_badge_<%= c.id %>">
                    <% if (c.last_seen_at && (Date.now() - c.last_seen_at) < 35000) { %>
                      <span class="badge badge-success" style="box-shadow: 0 0 10px rgba(34, 197, 94, 0.4);">🟢 En Ligne</span>
                    <% } else { %>
                      <span class="badge" style="background:rgba(255,255,255,0.05); color:#94A3B8;">🔴 Hors Ligne</span>
                    <% } %>
                  </td>
                  <td style="padding:14px 10px;" id="reseller_usage_text_<%= c.id %>">
                    <span style="font-weight:700; color:#F8FAFC;"><%= c.consumed_data_gb.toFixed(2) %> Go</span>
                    <span style="color:var(--text-muted); font-size:11px;">/ <%= c.max_data_gb > 0 ? c.max_data_gb + ' Go' : 'Illimité' %></span>
                  </td>
                  <td style="padding:14px 10px; font-family:monospace; color:var(--text-muted); font-size:12px;">
                    <%= c.allowed_hwids ? c.allowed_hwids : '🟢 Non verrouillé (1er appareil)' %>
                  </td>
                  <td style="padding:14px 10px;"><%= c.expiry_date ? c.expiry_date : 'Jamais' %></td>
                  <td style="padding:14px 10px;">
                    <span class="badge badge-<%= c.status === 'active' ? 'success' : 'danger' %>"><%= c.status %></span>
                  </td>
                  <td style="padding:14px 10px; text-align:right; white-space:nowrap;">
                    <button class="btn-ghost small" style="color:#A855F7; margin-right:4px;" title="Détails & Consommation par Serveur" onclick='openInfoCodeModal(<%- JSON.stringify(c) %>)'>ℹ️ Info</button>
                    <form method="POST" action="/reseller/access-codes/<%= c.id %>/reset-usage" style="display:inline;" onsubmit="return confirm('Réinitialiser la data consommée de ce code (<%= c.code %>) à 0 Go ?');">
                      <button class="btn-ghost small" style="color:#F59E0B; margin-right:4px;" title="Réinitialiser la Data">🔄 Reset</button>
                    </form>
                    <button class="btn-ghost small" style="color:#38BDF8; margin-right:4px;" onclick='openEditCodeModal(<%- JSON.stringify(c) %>)'>✏️ Éditer</button>
                    <form method="POST" action="/reseller/access-codes/<%= c.id %>/delete" style="display:inline;" onsubmit="return confirm('Supprimer ce code d\'accès ?');">
                      <button class="btn-ghost small" style="color:#EF4444;" type="submit">Supprimer</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toastMsg" class="toast-msg">📋 Clé copiée !</div>

  <!-- MODAL 1: Création Code Premium Revendeur -->
  <div id="modalCreateCode" class="modal-overlay">
    <div class="modal-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <h3 style="margin:0; font-size:18px; font-weight:800;">Générer une Clé d'Accès Premium</h3>
        <button onclick="closeModal('modalCreateCode')" style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-size:20px;">✕</button>
      </div>

      <form method="POST" action="/reseller/access-codes">
        <div class="form-group">
          <label>Référence Client / N° Téléphone</label>
          <input type="text" name="clientReference" placeholder="ex: +225 07080910 ou Jean Dupont" class="form-control" />
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
          <div class="form-group">
            <label>Enveloppe Data Globale (Go, 0 = Illimité)</label>
            <input type="number" step="0.5" name="maxDataGb" value="10" class="form-control" />
          </div>

          <div class="form-group">
            <label>Date d'Expiration Calendrier (Optionnel)</label>
            <input type="date" name="expiryDate" class="form-control" />
          </div>
        </div>

        <div class="form-group">
          <label>HWID / Device ID Client (Facultatif)</label>
          <input type="text" name="hwid" placeholder="Ex: HWID-A1B2C3D4E5F6 (Vide = auto-liaison au 1er clic)" class="form-control" />
        </div>

        <% if (extraTemplates && extraTemplates.length > 0) { %>
          <div class="form-group" style="margin-top:18px; border-top:1px solid var(--border); padding-top:14px;">
            <label>Serveurs Premium Optionnels à Inclure & Limites Data Spécifiques</label>
            <div style="max-height:160px; overflow-y:auto; border:1px solid var(--border); border-radius:10px; padding:10px; background:var(--bg);">
              <% extraTemplates.forEach(t => { %>
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; gap:10px;">
                  <label style="display:flex; align-items:center; gap:8px; font-size:13px; cursor:pointer;">
                    <input type="checkbox" name="selectedTemplateIds" value="<%= t.id %>" checked />
                    <span style="font-weight:600; color:#F8FAFC;"><%= t.name %></span>
                    <span class="badge badge-purple" style="font-size:10px; padding:2px 6px;"><%= t.protocol.toUpperCase() %></span>
                  </label>
                  <input type="number" step="0.5" name="template_max_gb_<%= t.id %>" placeholder="Go (0=global)" class="form-control" style="width:110px; padding:4px 8px; font-size:11px;" />
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>

        <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:24px;">
          <button type="button" class="btn-ghost" onclick="closeModal('modalCreateCode')">Annuler</button>
          <button type="submit" class="btn-primary" style="background:#22C55E; border:none;">Générer la Clé</button>
        </div>
      </form>
    </div>
  </div>

  <!-- MODAL 2: Éditeur Code Premium Revendeur -->
  <div id="modalEditCode" class="modal-overlay">
    <div class="modal-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <h3 style="margin:0; font-size:18px; font-weight:800;">✏️ Éditer le Code Premium</h3>
        <button onclick="closeModal('modalEditCode')" style="background:none; border:none; color:var(--text-muted); cursor:pointer; font-size:20px;">✕</button>
      </div>

      <form method="POST" id="formEditCode" action="">
        <div class="form-group">
          <label>Référence Client / N° Téléphone</label>
          <input type="text" name="clientReference" id="editCodeClientRef" class="form-control" />
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
          <div class="form-group">
            <label>Plafond Data Globale (Go, 0 = Illimité)</label>
            <input type="number" step="0.5" name="maxDataGb" id="editCodeMaxDataGb" class="form-control" />
          </div>

          <div class="form-group">
            <label>Date d'Expiration Calendrier (`expiryDate`)</label>
            <input type="date" name="expiryDate" id="resellerEditCodeExpiryDate" class="form-control" />
          </div>
        </div>

        <div style="display:grid; grid-template-columns:2fr 1fr; gap:14px;">
          <div class="form-group">
            <label>HWID (Laissez vide pour Réinitialiser le Verrouillage Appareil)</label>
            <input type="text" name="hwid" id="editCodeHwid" placeholder="Ex: A1B2C3D4 (Vide = déverrouiller)" class="form-control" />
          </div>

          <div class="form-group">
            <label>Statut</label>
            <select name="status" id="editCodeStatus" class="form-control">
              <option value="active">Active</option>
              <option value="expired">Expired</option>
              <option value="depleted">Depleted</option>
              <option value="locked">Locked</option>
            </select>
          </div>
        </div>

        <% if (extraTemplates && extraTemplates.length > 0) { %>
          <div class="form-group" style="margin-top:18px; border-top:1px solid var(--border); padding-top:14px;">
            <label>Gérer les Serveurs Premium Optionnels Associés à ce Code</label>
            <div style="max-height:160px; overflow-y:auto; border:1px solid var(--border); border-radius:10px; padding:10px; background:var(--bg);">
              <% extraTemplates.forEach(t => { %>
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; gap:10px;">
                  <label style="display:flex; align-items:center; gap:8px; font-size:13px; cursor:pointer;">
                    <input type="checkbox" name="selectedTemplateIds" id="reseller_edit_code_tmpl_<%= t.id %>" value="<%= t.id %>" />
                    <span style="font-weight:600; color:#F8FAFC;"><%= t.name %></span>
                    <span class="badge badge-purple" style="font-size:10px; padding:2px 6px;"><%= t.protocol.toUpperCase() %></span>
                  </label>
                  <input type="number" step="0.5" name="template_max_gb_<%= t.id %>" id="reseller_edit_code_max_gb_<%= t.id %>" placeholder="Go (0=global)" class="form-control" style="width:110px; padding:4px 8px; font-size:11px;" />
                </div>
              <% }); %>
            </div>
          </div>
        <% } %>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:24px;">
          <button type="button" class="btn-ghost small" style="color:#F59E0B;" onclick="if(confirm('Remettre la consommation de ce code à 0 Go et le réactiver ?')) document.getElementById('resellerFormResetCodeUsage').submit();">🔄 Remettre Conso à 0 Go</button>
          <div style="display:flex; gap:12px;">
            <button type="button" class="btn-ghost" onclick="closeModal('modalEditCode')">Annuler</button>
            <button type="submit" class="btn-primary" style="background:#22C55E; border:none;">Enregistrer les Modifications</button>
          </div>
        </div>
      </form>
      <form method="POST" id="resellerFormResetCodeUsage" action="" style="display:none;"></form>
    </div>
  </div>

  <!-- MODAL INFOS ET CONSOMMATION DU CODE PREMIUM (RESELLER) -->
  <div id="modalInfoCode" class="modal-overlay">
    <div class="modal-card" style="max-width:650px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
        <h3 style="margin:0; font-size:20px; font-weight:900; display:flex; align-items:center; gap:8px;">
          <span style="display:inline-flex; align-items:center; justify-content:center; width:28px; height:28px; border-radius:50%; background:#A855F7; color:#FFF; font-size:15px; font-weight:bold;">i</span>
          Détails & Consommation du Code
        </h3>
        <button onclick="closeModal('modalInfoCode')" style="background:none; border:none; color:#94A3B8; cursor:pointer; font-size:22px;">✕</button>
      </div>

      <div style="background:rgba(255,255,255,0.03); border:1px solid var(--border); border-radius:12px; padding:16px; margin-bottom:20px;">
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; font-size:13px;">
          <div><span style="color:#94A3B8;">Code Premium :</span> <strong id="infoCodeStr" style="color:#38BDF8; font-family:monospace;"></strong></div>
          <div><span style="color:#94A3B8;">Référence Client :</span> <strong id="infoClientRef" style="color:#F8FAFC;"></strong></div>
          <div><span style="color:#94A3B8;">Statut :</span> <span id="infoStatus" class="badge"></span></div>
          <div><span style="color:#94A3B8;">Date Expiration :</span> <strong id="infoExpiry" style="color:#F8FAFC;"></strong></div>
          <div><span style="color:#94A3B8;">HWID Appareil :</span> <strong id="infoHwid" style="color:#F8FAFC; font-family:monospace;"></strong></div>
        </div>

        <div style="margin-top:16px; padding-top:14px; border-top:1px dashed var(--border);">
          <div style="display:flex; justify-content:space-between; margin-bottom:6px; font-size:13px;">
            <span style="color:#94A3B8; font-weight:600;">Consommation Globale Cumulée :</span>
            <strong id="infoTotalUsage" style="color:#F8FAFC;"></strong>
          </div>
        </div>
      </div>

      <h4 style="margin:0 0 12px 0; font-size:15px; font-weight:800; color:#F8FAFC;">📡 Consommation et Limites par Serveur Associé</h4>
      <div id="infoServersList" style="max-height:240px; overflow-y:auto; border:1px solid var(--border); border-radius:10px; padding:10px; background:rgba(0,0,0,0.2);">
        <!-- Populated via JS -->
      </div>

      <div style="display:flex; gap:12px; justify-content:flex-end; margin-top:24px;">
        <button type="button" class="btn-ghost" onclick="closeModal('modalInfoCode')">Fermer</button>
      </div>
    </div>
  </div>

  <script>
    function openModal(id) {
      document.getElementById(id).style.display = 'flex';
    }

    function closeModal(id) {
      document.getElementById(id).style.display = 'none';
    }

    function copyCode(code) {
      navigator.clipboard.writeText(code);
      var toast = document.getElementById('toastMsg');
      toast.innerText = '📋 Clé ' + code + ' copiée !';
      toast.style.display = 'block';
      setTimeout(function() {
        toast.style.display = 'none';
      }, 2500);
    }

    function openInfoCodeModal(c) {
      document.getElementById('infoCodeStr').innerText = c.code || '';
      document.getElementById('infoClientRef').innerText = c.client_reference || 'Client Général';
      document.getElementById('infoExpiry').innerText = c.expiry_date || 'Jamais';
      document.getElementById('infoHwid').innerText = c.allowed_hwids || '🟢 Non verrouillé';

      var statusSpan = document.getElementById('infoStatus');
      statusSpan.innerText = c.status || 'active';
      statusSpan.className = 'badge badge-' + (c.status === 'active' ? 'success' : 'danger');

      var totalGb = c.consumed_data_gb || 0;
      var maxGb = c.max_data_gb || 0;
      document.getElementById('infoTotalUsage').innerText = totalGb.toFixed(2) + ' Go / ' + (maxGb > 0 ? maxGb + ' Go' : 'Illimité');

      var container = document.getElementById('infoServersList');
      container.innerHTML = '';

      if (c.credentials && Array.isArray(c.credentials) && c.credentials.length > 0) {
        c.credentials.forEach(function(cr) {
          var sConsumed = cr.consumed_data_gb || 0;
          var sMax = cr.template_max_data_gb || 0;
          var div = document.createElement('div');
          div.style.padding = '8px 10px';
          div.style.marginBottom = '6px';
          div.style.background = 'rgba(255,255,255,0.03)';
          div.style.borderRadius = '8px';
          div.style.display = 'flex';
          div.style.justifyContent = 'space-between';
          div.style.alignItems = 'center';
          div.style.fontSize = '12px';

          div.innerHTML = '<div><strong style="color:#F8FAFC;">' + (cr.name || 'Serveur') + '</strong> <span class="badge badge-purple" style="font-size:9px;">' + (cr.protocol || '').toUpperCase() + '</span></div>' +
                          '<div><strong style="color:#38BDF8;">' + sConsumed.toFixed(2) + ' Go</strong> / <span style="color:#94A3B8;">' + (sMax > 0 ? sMax + ' Go' : 'Global Code') + '</span></div>';
          container.appendChild(div);
        });
      } else {
        container.innerHTML = '<div style="color:#94A3B8; font-size:12px; text-align:center; padding:10px;">Aucun serveur spécifique renseigné.</div>';
      }

      openModal('modalInfoCode');
    }

    function openEditCodeModal(c) {
      document.getElementById('formEditCode').action = '/reseller/access-codes/' + c.id + '/edit';
      if (document.getElementById('resellerFormResetCodeUsage')) {
        document.getElementById('resellerFormResetCodeUsage').action = '/reseller/access-codes/' + c.id + '/reset-usage';
      }
      document.getElementById('editCodeClientRef').value = c.client_reference || '';
      document.getElementById('editCodeMaxDataGb').value = c.max_data_gb || 0;
      document.getElementById('resellerEditCodeExpiryDate').value = c.expiry_date || '';
      document.getElementById('editCodeHwid').value = c.allowed_hwids || '';
      document.getElementById('editCodeStatus').value = c.status || 'active';

      <% if (extraTemplates && extraTemplates.length > 0) { %>
        <% extraTemplates.forEach(t => { %>
          var chk = document.getElementById('reseller_edit_code_tmpl_' + <%= t.id %>);
          var inputGb = document.getElementById('reseller_edit_code_max_gb_' + <%= t.id %>);
          if (chk) chk.checked = false;
          if (inputGb) inputGb.value = '';
        <% }); %>
        if (c.credentials && Array.isArray(c.credentials)) {
          c.credentials.forEach(function(cr) {
            var chk = document.getElementById('reseller_edit_code_tmpl_' + cr.config_template_id);
            var inputGb = document.getElementById('reseller_edit_code_max_gb_' + cr.config_template_id);
            if (chk) chk.checked = true;
            if (inputGb && cr.template_max_data_gb) inputGb.value = cr.template_max_data_gb;
          });
        }
      <% } %>

      openModal('modalEditCode');
    }

    // Live Auto-Refresh Polling for Reseller Access Codes (5s)
    (function() {
      function pollResellerData() {
        fetch('/reseller/access-codes/data').then(function(r) { return r.json(); }).then(function(data) {
          if (!data || !data.accessCodes) return;

          if (document.getElementById('resellerOnlineBadge')) {
            document.getElementById('resellerOnlineBadge').innerHTML = '🟢 ' + data.onlineCount + ' Clients En Ligne';
          }
          if (document.getElementById('resellerQuotaText') && data.resellerQuotaGb !== undefined) {
            document.getElementById('resellerQuotaText').innerText = data.resellerQuotaGb !== null ? data.resellerQuotaGb.toFixed(2) + ' Go' : 'Illimité';
          }

          data.accessCodes.forEach(function(c) {
            var isOnline = c.last_seen_at && (Date.now() - c.last_seen_at) < 35000;
            var onlineBadgeCell = document.getElementById('reseller_online_badge_' + c.id);
            if (onlineBadgeCell) {
              onlineBadgeCell.innerHTML = isOnline
                ? '<span class="badge badge-success" style="box-shadow: 0 0 10px rgba(34, 197, 94, 0.4);">🟢 En Ligne</span>'
                : '<span class="badge" style="background:rgba(255,255,255,0.05); color:#94A3B8;">🔴 Hors Ligne</span>';
            }

            var usageCell = document.getElementById('reseller_usage_text_' + c.id);
            if (usageCell) {
              usageCell.innerHTML = '<span style="font-weight:700; color:#F8FAFC;">' + (c.consumed_data_gb || 0).toFixed(2) + ' Go</span> <span style="color:var(--text-muted); font-size:11px;">/ ' + (c.max_data_gb > 0 ? c.max_data_gb + ' Go' : 'Illimité') + '</span>';
            }
          });
        }).catch(function() {});
      }

      setInterval(pollResellerData, 5000);
    })();
  </script>
</body>
</html>
